# Copy these values into the server process environment before npm run server.
# PostgreSQL must be running and accepting this connection.
DATABASE_URL=postgresql://postgres:password@localhost:5432/escape_house
OPENAI_API_KEY=replace-with-your-server-api-key
# Optional overrides:
OPENAI_MODEL=gpt-4.1-mini
QUESTION_AGENT_INTERVAL_MS=600000
